# 本机 Git 元数据（因受限工作区使用 .git 文件指向此目录）
.git-data/

# Vivado / Vitis 生成目录与临时文件
.Xil/
hw/build/synth_*/
# 当前 Tcl 构建产生的 Vivado 工程中间目录；export/ 中的交付制品保留版本管理。
hw/build/dna_accel.cache/
hw/build/dna_accel.gen/
hw/build/dna_accel.hw/
hw/build/dna_accel.runs/
hw/build/dna_accel.srcs/
hw/build/dna_accel.xpr
hw/build/reports/
hw/build/xsim/
sw/workspace/
*.jou
*.log
# 例外：板端 UART 实录是上板判据的证据，必须入库（作用域仅此目录）
!docs/board/run-logs/*.log
*.str
*.pb
*.wdb
# 运行留证目录：默认不入库（体量大、每次运行都新建一个 run-id 子目录）。
# 结论与判据写进 docs/，需要保留的**单份小证据**用 git add -f 显式入库
# （例如 logs/vivado/.../physopt/summary.log、logs/multi_payload/repeat3_*/report.md）。
# 2026-09-10：补齐本轮新增的 6 个目录——它们此前未被覆盖，
# 一旦有人误用 git add -A 就会把几百 MB 的运行产物卷进仓库。
# 2026-09-11：改为**整体忽略 logs/ 下的运行目录**，再用否定模式放行刻意入库的
# 单份证据。此前是逐个目录列举，每新增一个日志目录就漏一个——tools/check_repo_hygiene.sh
# 第一次运行就抓到 5 个漏网目录。默认忽略、例外放行，比逐个补要稳。
logs/*/
!logs/README.md
# 以下是刻意入库的小份证据（体积小、被 docs 直接引用）
!logs/vivado/
logs/vivado/*/
!logs/vivado/recovery_20260909/
!logs/multi_payload/
logs/multi_payload/*/
!logs/multi_payload/repeat3_20260910T200339Z/

# Python 缓存
__pycache__/
*.py[cod]
tools/*.so

# 本地导入的只读数据与历史归档。
# 校验和、来源和使用约束记录在 docs/reference/；如需远端保存大文件，请另行使用 Git LFS 或制品库。
data/
archive/

# 板卡资料包（docs/board/）整体纳入版本管理，只排除体积过大的教学视频；
# 其 SHA-256 仍记录在 docs/board/zynq-eco-7010/SHA256SUMS.txt 中，可按需另行获取。
docs/board/**/tutorials/*.mp4

# 编辑器与操作系统本地文件
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# 多 agent 实时工作看板（本机可见即可，不进版本管理）；
# 由 tools/agent_view.sh 生成，结论与判据仍写入 docs/ 并提交。
view.md
.agent_view/

# 压测中间转储数据文件（体积过大且已在 results.jsonl 完整记录）
tests/stress_results/**/dec_run_*.txt
# docs 历史归档需要纳入版本管理；仅仓库根 archive/ 继续忽略。
!docs/archive/
!docs/archive/history/
!docs/archive/history/2026/
!docs/archive/history/2026/**
