# 本机 Git 元数据
.git-data/

# 运行临时与崩溃文件
.Xil/
*.jou
*.log
!board/run-logs/*.log
*.str
*.pb
*.wdb

# Vivado / Vitis 生成目录与临时工程（build/artifact 与 build/reports 纳入版本管理）
build/vivado/
build/software-export/
build/workspace/
src/sw/workspace/

# 运行留证目录与本地归档（本地归档含提交物原件、原始板测数据与涉密隔离区）
archive/
logs/*/
!logs/README.md

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*.so

# 客户端打包产物（30 MB gui_app.exe 进本地归档与 Release 附件，源码与 spec 纳入版本管理）
*.exe
src/clients/dist/
src/clients/python/build/
src/clients/python/gui_app.exe

# 视频渲染中间缓存与大成片（成片 105 MB 超过 GitHub 单文件限制，归档至 archive/submission-2026/）
dna-readout-video/dna-readout-explainer.mp4
dna-readout-video/build/
dna-readout-video/stills/

# 编辑器与操作系统本地文件
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# 多 Agent 实时工作看板（本机可见即可，不进版本管理）
view.md
.agent_view/
src/logs/
